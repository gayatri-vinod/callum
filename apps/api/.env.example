APP_NAME=callum
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local default (no Docker required):
DATABASE_URL=sqlite+aiosqlite:///./data/callum.db

# Postgres (docker compose):
# DATABASE_URL=postgresql+asyncpg://callum:callum@localhost:5432/callum

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Storage: auto | minio | local
STORAGE_BACKEND=auto
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=callum
MINIO_SECRET_KEY=callumsecret
MINIO_BUCKET=callum
MINIO_SECURE=false
UPLOAD_DIR=./data/uploads

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
